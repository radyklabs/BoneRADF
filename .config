<?php declare (strict_types=1);

if (!defined ('basepath')){ http_response_code (404);
exit ('<h1>404 Not Found</h1><p>The requested page could not be found.</p>');}

@include_once $call ('implode', '.', [$call ('dirname', basepath).sep, 'supports']);

if (!is_callable ('interlace') || !isset ($directories))
{
    die ("<h1>{$heading}</h1><p>Supports: {$message}</p>");
}

foreach ($directories as $type => $dir)
{
    // $namespace = $type === 'system' ? "Boneradf\\" : "Modules\\";
    // $lock_as ('ns'.substr ($type, 0, 3), $namespace );
    $lock_as ($type, interlace ($call ('dirname', basepath), $dir));
}

$kernel_directory = 'Kernel';
$lock_as ('nskernel', namespacify (interlace ("Boneradf", $kernel_directory)));
$lock_as ('kernel', interlace (system, $kernel_directory));

// Compute the boot class name first, then require the file, then prove the
// class actually landed (require_once would fatal on a missing file — caught
// + dumped by the caller).
$bootkey = namespacify (interlace (nskernel, 'Boot'));

require_once interlace (kernel, 'Boot.php');

if (!class_exists ($bootkey, false))
{
     die ("<h1>{$heading}</h1><p>Boot: {$message}</p>");
}