# BoneRADF dev env — gitignored. Copy from CONFIG.sample.md / docs/CONFIG.md.
app.key=dev-app-key

# Runtime connection selector (default|test|<any name below>)
database.env=default

database.default.driver=mysql
database.default.host=localhost
database.default.port=3306
database.default.name=database
database.default.charset=utf8mb4
database.default.user=root
database.default.pass=

database.test.driver=mysql
database.test.host=localhost
database.test.port=3306
database.test.name=database
database.test.charset=utf8mb4
database.test.user=root
database.test.pass=